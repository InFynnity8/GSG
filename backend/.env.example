# ─────────────────────────────────────────────────────────────────────────────
# GSG website API — environment variables
# Copy to .env for local development. On Render, set these in the dashboard
# (Environment tab). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Public URL of this API (Render: https://gsg-xs4r.onrender.com)
APP_URL=http://localhost:4000
# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Neon Postgres ──
# Pooled connection (host contains "-pooler") — used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (no "-pooler") — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Auth ──
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# First super admin, created by `npm run db:seed` (only if it doesn't exist)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-10-chars
SEED_ADMIN_NAME=Super Admin

# ── Neon Object Storage (S3-compatible) ──
# Get these with `neon env pull` or from the Neon Console → Storage.
# The API boots without them; media endpoints return 503 until set.
AWS_ENDPOINT_URL_S3=https://<branch-storage-endpoint>
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket name — create it in Neon with access level "public_read"
STORAGE_BUCKET=gsg-media
# Optional: override the public base URL (defaults to <endpoint>/<bucket>)
STORAGE_PUBLIC_BASE_URL=
STORAGE_MAX_UPLOAD_MB=10
STORAGE_MAX_PRESIGNED_UPLOAD_MB=200

# ── Paystack ──
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Resend (email) ──
# API key: resend.com/api-keys. Without it the API works but sends no emails.
RESEND_API_KEY=re_xxx
# Must be on a domain verified in Resend (resend.com/domains).
# onboarding@resend.dev only delivers to your own Resend account email.
MAIL_FROM="God Seeking Generation <noreply@your-domain.org>"
# Where replies to automated emails go
MAIL_REPLY_TO=godseekinggeneration01@gmail.com
# Inbox(es) that receive contact / prayer / testimony / order notifications
MAIL_NOTIFY_TO=godseekinggeneration01@gmail.com
# Resend → Audience → Segments: the segment that newsletter broadcasts go to
RESEND_NEWSLETTER_SEGMENT_ID=
# Public website URL — used for links and the logo in emails
WEBSITE_URL=https://your-website-domain
# Optional: admin panel URL (links in notification emails)
ADMIN_URL=
# Optional: logo for emails (defaults to WEBSITE_URL/GSG.png)
MAIL_LOGO_URL=

# ── Misc ──
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
